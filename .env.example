# ================= Flask 基础 =================
FLASK_ENV=production            # development | production | testing
# 必填（生产）：32+ 位随机字符串，可用 python3 -c "import secrets; print(secrets.token_hex(32))" 生成
SECRET_KEY=

# ================= 管理端 =================
# /api/admin/analytics/* 的访问令牌（X-Admin-Token 头）。不设置则管理端整体禁用
ADMIN_TOKEN=

# ================= 短信（阿里云） =================
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SIGN_NAME=
ALIYUN_TEMPLATE_CODE=
# 本地联调需回传验证码明文时才开启（生产务必关闭）
# SMS_DEMO_MODE=1

# ================= 邮件（SMTP，密码重置用） =================
SMTP_SERVER=
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=

# ================= OAuth 第三方登录 =================
SITE_URL=https://xuanjisuanming.top
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
QQ_APP_ID=
QQ_APP_KEY=

# ================= 可选：限流后端 =================
# 多 worker 部署建议使用 Redis（默认 memory:// 仅进程内有效）
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0

# ================= 可选：下载代理缓存目录 =================
# DOWNLOADS_DIR=/root/suanming/downloads
