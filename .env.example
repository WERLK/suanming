# Flask 配置
FLASK_ENV=production
FLASK_APP=api.app
SECRET_KEY=your-secret-key-here-change-in-production

# JWT 配置
JWT_SECRET_KEY=your-jwt-secret-key-here-change-in-production
JWT_EXPIRATION_DELTA=24

# 阿里云短信配置（二选一）
ALIYUN_ACCESS_KEY_ID=your-aliyun-access-key-id
ALIYUN_ACCESS_KEY_SECRET=your-aliyun-access-key-secret
ALIYUN_SIGN_NAME=玄机算命网
ALIYUN_TEMPLATE_CODE=SMS_123456789

# 腾讯云短信配置（二选一）
TENCENT_SECRET_ID=your-tencent-secret-id
TENCENT_SECRET_KEY=your-tencent-secret-key
TENCENT_SMS_SDK_APP_ID=1400000000
TENCENT_SIGN_NAME=玄机算命网
TENCENT_TEMPLATE_ID=123456

# 数据库配置（如果使用 MySQL/PostgreSQL）
# <DB_CONNECTION_REDACTED>
# <DB_CONNECTION_REDACTED>

# Redis 配置（用于生产环境会话管理）
# REDIS_URL=<DB_CONNECTION_REDACTED>

# 日志配置
LOG_LEVEL=info
LOG_DIR=/workspace/logs
