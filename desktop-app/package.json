{
  "name": "xuanji-desktop",
  "version": "1.0.0",
  "description": "玄机算命网 - 桌面客户端",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win --x64",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "keywords": ["玄学", "算命", "桌面应用", "八字", "风水"],
  "author": "玄机算命网",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/WERLK/suanming.git"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "top.xuanjisuanming.desktop",
    "productName": "玄机算命",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "index.html",
      "preload.js"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns",
      "category": "public.app-category.lifestyle"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png",
      "category": "Lifestyle"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "玄机算命"
    }
  }
}
